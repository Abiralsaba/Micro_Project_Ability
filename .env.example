# Copy this file to .env and keep the real credential private.
GEMINI_API_KEY=replace_with_a_new_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# These defaults automatically reuse the existing NationX whisper.cpp install.
# WHISPER_CPP_ROOT=/Users/your-name/Library/Application Support/NationX/whisper.cpp
# WHISPER_MODEL=/path/to/ggml-large-v3-turbo.bin
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
